# Продакшен: cp .env.prod.example .env.prod и заполни значения.
# .env.prod не коммитится (см. .gitignore).

DOMAIN=bahor.example.uz

DJANGO_SETTINGS_MODULE=config.settings.prod
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=bahor.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://bahor.example.uz
# Нестандартный адрес админки, со слешем в конце
DJANGO_ADMIN_URL=manage-a8f3/
SITE_URL=https://bahor.example.uz

POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
# Длинный случайный пароль
POSTGRES_PASSWORD=
DATABASE_URL=postgres://restaurant:ПАРОЛЬ_ИЗ_POSTGRES_PASSWORD@db:5432/restaurant

REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER=redis

# Оплата: только stripe (fake запрещён в продакшене)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Почта для напоминаний о брони, например smtp+tls://user:password@smtp.gmail.com:587
# consolemail:// — письма только в лог (пока почта не настроена). Пустым не оставлять
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Чайхана Bahor <noreply@bahor.example.uz>

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
