# Скопируй в .env: cp .env.example .env

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Публичный адрес сайта: зашивается в QR-коды столов
SITE_URL=http://localhost:8000

# PostgreSQL (контейнер db)
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
DATABASE_URL=postgres://restaurant:restaurant@db:5432/restaurant

# Redis: брокер Celery и слой Channels (WebSocket)
REDIS_URL=redis://redis:6379/0
# memory — только для запуска без Redis в одном процессе
CHANNEL_LAYER=redis

# Онлайн-оплата: fake — имитация для разработки, stripe — Stripe Checkout (test mode)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram-уведомления менеджеру (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
