# Скопируй в .env: cp .env.example .env

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (контейнер db)
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant
DATABASE_URL=postgres://restaurant:restaurant@db:5432/restaurant

# Redis: брокер Celery, позже и слой Channels
REDIS_URL=redis://redis:6379/0

# Telegram-уведомления менеджеру (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
